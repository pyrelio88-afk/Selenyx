{
  "name": "selenyx",
  "version": "2.0.0-alpha",
  "private": true,
  "description": "Selenyx 科研工作台 — 本地优先、BYOK、八段科研流水线（TypeScript + Python + Tauri 多语言架构）",
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace @selenyx/frontend run dev",
    "build": "npm --workspace @selenyx/frontend run build",
    "typecheck": "npm --workspace @selenyx/frontend run typecheck",
    "test": "npm --workspace @selenyx/frontend run test",
    "verify:local": "node scripts/verify-local.mjs",
    "backend:dev": "cd backend && uv run uvicorn selenyx_backend.main:app --reload --port 8770",
    "backend:test": "cd backend && uv run pytest -q",
    "desktop:dev": "cd desktop && cargo tauri dev",
    "desktop:build": "cd desktop && cargo tauri build",
    "lint": "npm --workspace @selenyx/frontend run lint"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
