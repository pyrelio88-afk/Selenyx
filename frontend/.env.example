# Copy this file to frontend/.env.local for local development only.
# Vite exposes only VITE_* values through import.meta.env and writes them into
# the browser bundle at build time. They are client-visible, not secret storage.
#
# Never commit frontend/.env.local. Do not put a long-lived or privileged
# production key here. If a test key is necessary, scope and rotate it.

# Optional public/local model connection settings.
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=

# Optional local-development-only key. This value will be visible in the built
# client artifact; leave empty for distributable builds.
VITE_LLM_API_KEY=
