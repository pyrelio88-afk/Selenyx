# Pexels API Key — 用于 UI 设计配图搜索
# 申请地址: https://www.pexels.com/api/
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Leave empty for the browser development server: Vite proxies /api locally.
# For a phone connecting to the companion backend, use a trusted HTTPS URL:
# VITE_API_BASE_URL=https://selenyx.local.example/api
VITE_API_BASE_URL=
