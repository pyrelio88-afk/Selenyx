{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selenyx",
  "version": "2.0.0-alpha",
  "identifier": "com.selenyx.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix .. run dev:local",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Selenyx 科研工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.selenyx/**", "$DOCUMENT/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Selenyx",
    "category": "Education",
    "shortDescription": "Selenyx 科研工作台 — 本地优先、BYOK、八段科研流水线",
    "longDescription": "Selenyx 是面向护理与医学科研的本地优先工作台：问题→文献→全文→筛选→精读→证据→综合→写作 八段流水线，多主题设计系统，文献管理 / BibTeX-RIS / PDF 全文阅读 / OCR / AI 助手 / 全学科参数库。数据本地存储，BYOK。桌面 (Windows/macOS/Linux) + Android 跨平台。",
    "copyright": "MIT © Selenyx Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["binaries/selenyx-backend"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": []
    }
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "scope": ["$HOME/.selenyx/**", "$DOCUMENT/**", "$APPDATA/**"] },
    "store": {}
  }
}
