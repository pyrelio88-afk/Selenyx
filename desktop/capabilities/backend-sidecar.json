{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "backend-sidecar",
  "description": "Allows the desktop app to start its bundled local API service.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/selenyx-backend",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
