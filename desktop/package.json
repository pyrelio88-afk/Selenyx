{
  "name": "selenyx-desktop",
  "version": "0.8.0-rc.4",
  "private": true,
  "description": "Selenyx Desktop — local-first research assistant",
  "main": "main.js",
  "author": "pyrelio88-afk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.selenyx.desktop",
    "productName": "Selenyx",
    "artifactName": "Selenyx-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      {
        "from": "../src",
        "to": "engine"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Selenyx-${version}-windows-${arch}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Selenyx"
    },
    "portable": {
      "artifactName": "Selenyx-${version}-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    }
  }
}
