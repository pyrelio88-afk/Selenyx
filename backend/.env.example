# Copy to backend/.env.local for development. Packaged desktop builds also read
# the same filename from ~/.selenyx/.env.local. This file must stay private.
# The packaged sidecar is permanently bound to 127.0.0.1:8770.
SELENYX_DATA_DIR=
SELENYX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Optional OpenAI-compatible LLM (Agnes example):
# SELENYX_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
# SELENYX_LLM_API_KEY=
# SELENYX_LLM_MODEL=agnes-2.5-flash
SELENYX_LLM_BASE_URL=https://api.openai.com/v1
SELENYX_LLM_API_KEY=
SELENYX_LLM_MODEL=gpt-4o-mini

# Optional dense embeddings. If left blank, Selenyx uses its zero-download
# deterministic hash + lexical retrieval and remains fully offline.
# Recommended local profile (model is NOT bundled; pull it explicitly first):
#   ollama pull embeddinggemma
# SELENYX_EMBED_PROVIDER=ollama
# SELENYX_EMBED_BASE_URL=http://127.0.0.1:11434
# SELENYX_EMBED_MODEL=embeddinggemma
# SELENYX_EMBED_API_KEY=
# SELENYX_EMBED_TIMEOUT_SECONDS=30

# OpenAI-compatible embedding endpoint alternative:
# SELENYX_EMBED_PROVIDER=openai-compatible
# SELENYX_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# SELENYX_EMBED_MODEL=embeddinggemma

# Optional asymmetric retrieval instructions. Keep empty for EmbeddingGemma
# and BGE-M3. Example for multilingual-e5-small:
# SELENYX_EMBED_QUERY_PREFIX="query: "
# SELENYX_EMBED_DOCUMENT_PREFIX="passage: "

SELENYX_OPENALEX_MAILTO=selenyx@research.local
# SELENYX_OPENALEX_API_KEY=
